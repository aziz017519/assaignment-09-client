# Copy this file to .env.local for local development, or add these values in the
# Vercel dashboard. Never commit real values.

# Deployed Express backend origin, e.g. https://your-backend.vercel.app
# Do not include a trailing /api; the app appends /api/... itself.
NEXT_PUBLIC_API_URL=PASTE_DEPLOYED_BACKEND_URL

# Deployed frontend origin, e.g. https://your-frontend.vercel.app
# Used as the fallback BetterAuth base URL.
NEXT_PUBLIC_APP_URL=PASTE_DEPLOYED_FRONTEND_URL

# ImgBB API key used for image uploads.
NEXT_PUBLIC_IMGBB_API_KEY=PASTE_IMGBB_API_KEY

# BetterAuth server/client base URL. Use the deployed frontend origin.
BETTER_AUTH_URL=PASTE_DEPLOYED_FRONTEND_URL

# Secret used by BetterAuth for cookies and session signing.
BETTER_AUTH_SECRET=PASTE_BETTER_AUTH_SECRET

# MongoDB connection string used by the BetterAuth Mongo adapter.
BETTER_AUTH_DB_URI=PASTE_MONGODB_CONNECTION_STRING

# Fallback signing secret for /api/token when BETTER_AUTH_SECRET is unavailable.
# Use the same value as the backend JWT secret so tokens are accepted.
JWT_SECRET=PASTE_BACKEND_JWT_SECRET
